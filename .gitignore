# Binaries & build output
/yata
yata.exe~
*.exe
static/dashboard.js
web/dist/
dist/

# Editor / tooling
.claude/
.vscode/
.idea/

# User data — never commit credentials or local databases
config.json
*.db
*.db-wal
*.db-shm
data/
.env
.env.*

# Local test instance (throwaway config and database) and local-only tools
/test/
/tools/local/
*_local_test.go

# Local notes, never committed
*.local.md
CLAUDE.local.md

# Rolling log files (may contain paths/usernames — never commit)
yata.log.*
*.log

# Config backups (contain credentials — never commit)
backups/

# Node
web/node_modules/

# Saved tracker pages (contain personal profile data)
reference/

# Self-hosted Font Awesome (e.g. Pro) — licensed assets, must NOT ship in the public repo
static/fontawesome/

# OS noise
.DS_Store
Thumbs.db
