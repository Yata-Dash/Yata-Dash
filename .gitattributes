# Normalize line endings: store LF in the repo, check out native on each OS.
* text=auto

# Explicitly text (LF) — avoids CRLF creeping into source on Windows clients.
*.go   text
*.ts   text
*.js   text
*.mjs  text
*.css  text
*.html text
*.json text
*.jsonc text
*.md   text
*.mod  text
*.sum  text
*.yml  text

# Windows scripts stay CRLF.
*.ps1  text eol=crlf
*.bat  text eol=crlf

# Binary assets — never touch.
*.png  binary
*.svg  text
*.exe  binary
